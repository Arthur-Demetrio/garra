<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="garra_final">

  <!-- Materials (shared across all assemblies) -->
  <material name="A_o">
    <color rgba="0.627 0.627 0.627 1.0"/>
  </material>
  <material name="Laminado_vermelho_fosco">
    <color rgba="0.769 0.208 0.153 1.0"/>
  </material>
  <material name="Alum_nio_prata_anodizada">
    <color rgba="0.537 0.537 0.537 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find garra_final_description)/urdf/assemblies/Nova_Pin_a.urdf.xacro"/>
  <xacro:include filename="$(find garra_final_description)/urdf/assemblies/garra_final.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:Nova_Pin_a prefix=""/>
  <xacro:garra_final prefix=""/>

  <!-- Mount joints (cross-assembly connections) -->
  <!-- These define how assemblies connect to each other. -->
  <!-- When swapping a dummy assembly with a real part, -->
  <!-- update the include + macro call above, and adjust -->
  <!-- parent/child link names in the mount joint below. -->

  <joint name="R_gido_54" type="fixed">
    <parent link="motor_pequeno"/>
    <child link="Componente4_Espelhar"/>
    <origin xyz="-0.085228 0.152296 -0.057500" rpy="-1.570796 1.570796 0.000000"/>
  </joint>

</robot>