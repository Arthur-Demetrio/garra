      <parent link="${prefix}garra_final_showder_servo_horn_2"/>
      <child link="${prefix}M_dulo_2"/>
      <origin xyz="0.163486 0.095030 -0.005666" rpy="-1.570796 0.000000 2.443461"/>
    </joint>

    <joint name="${prefix}R_gido_51" type="fixed">
      <parent link="${prefix}M_dulo_2"/>
      <child link="${prefix}MOTOR_1_1"/>
      <origin xyz="0.001615 0.000015 0.004041" rpy="0.000000 0.000000 0.000000"/>
    </joint>

    <!-- Corrigido com medidas da montagem real: J3 e paralela a J1 e J2. L1=127 mm, L2=75 mm, J3-ponta=160 mm. -->
    <link name="${prefix}pulso_j3">
  <!-- Suporte aproximado entre punho e garra: existe na montagem, nao no CAD. -->
  <visual><origin xyz="0 0.0317 0" rpy="0 0 0"/><geometry><box size="0.04 0.0634 0.03"/></geometry><material name="A_o"/></visual>
  <collision><origin xyz="0 0.0317 0" rpy="0 0 0"/><geometry><box size="0.04 0.0634 0.03"/></geometry></collision>
</link>

    <joint name="${prefix}Revolucionar_52" type="revolute">
      <parent link="${prefix}MOTOR_1_1"/>
      <child link="${prefix}pulso_j3"/>
      <origin xyz="0.137538354 0.000361999 0.173960195" rpy="1.570739169 1.569233425 -0.000057438"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="1.86" velocity="1.00"/>
    </joint>

    <joint name="${prefix}pulso_j3_caixa" type="fixed">
      <parent link="${prefix}pulso_j3"/>
      <child link="${prefix}Caixa_motor_pequeno"/>
      <origin xyz="0.013030276 0.065999938 0.001727093" rpy="-1.570796639 0.121414327 3.141591963"/>
    </joint>

    <joint name="${prefix}R_gido_53" type="fixed">
      <parent link="${prefix}Caixa_motor_pequeno"/>
      <child link="${prefix}motor_pequeno"/>
      <origin xyz="0.170546 0.057500 -0.099228" rpy="-1.623428 1.570796 -0.174046"/>
    </joint>

