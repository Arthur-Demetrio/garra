        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}R_gido" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}shoulder_motor"/>
      <origin xyz="-0.002399 0.000644 0.000258" rpy="0.000000 0.011578 0.000000"/>
    </joint>

    <joint name="${prefix}Revolucionar_46" type="continuous">
      <parent link="${prefix}shoulder_motor"/>
      <child link="${prefix}garra_final_showder_servo_horn"/>
      <origin xyz="-0.023838 -0.025144 0.086064" rpy="1.570796 1.131260 0.000000"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}R_gido_47" type="fixed">
      <parent link="${prefix}garra_final_showder_servo_horn"/>
      <child link="${prefix}M_dulo_1"/>
      <origin xyz="0.074914 0.050317 -0.030000" rpy="-1.570796 0.000000 1.832596"/>
    </joint>

    <joint name="${prefix}R_gido_48" type="fixed">
      <parent link="${prefix}M_dulo_1"/>
      <child link="${prefix}MOTOR_1"/>
      <origin xyz="0.002592 -0.000644 0.004103" rpy="0.000000 0.000000 0.000000"/>
    </joint>

    <joint name="${prefix}Revolucionar_49" type="continuous">
      <parent link="${prefix}MOTOR_1"/>
      <child link="${prefix}garra_final_showder_servo_horn_2"/>
      <origin xyz="0.059838 -0.008856 0.173222" rpy="1.570796 1.536874 0.000000"/>
      <axis xyz="0.000000 0.000000 -1.000000"/>
      <limit effort="100.0" velocity="1.00"/>
