    <joint name="${prefix}R_gido_50" type="fixed">
      <parent link="${prefix}garra_final_showder_servo_horn_2"/>
      <child link="${prefix}M_dulo_2"/>
      <origin xyz="0.160854 0.091479 -0.006666" rpy="-1.570796 0.000000 2.443461"/>
    </joint>

    <joint name="${prefix}R_gido_65" type="fixed">
      <parent link="${prefix}M_dulo_2"/>
      <child link="${prefix}MOTOR_1_1"/>
      <origin xyz="-0.000300 -0.000428 0.000662" rpy="0.000000 0.000000 0.000000"/>
    </joint>

    <joint name="${prefix}Revolucionar_72" type="continuous">
      <parent link="${prefix}MOTOR_1_1"/>
      <child link="${prefix}garra_final_showder_servo_horn_3"/>
      <origin xyz="0.146796 0.022261 0.173559" rpy="1.570796 1.545249 3.141593"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <!-- ROS 2 control: generated generic system -->
    <ros2_control name="${prefix}garra_final_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/garra_final_system/cmd</param>
        <param name="state_topic">sim/garra_final_system/state</param>
      </hardware>

      <joint name="${prefix}Revolucionar_46">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolucionar_49">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolucionar_72">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

