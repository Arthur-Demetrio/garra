<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="garra_final">

    <xacro:arg name="initial_positions_file" default="$(find garra_moveit_config)/config/initial_positions.yaml"/>
    <!-- Por padrao, hardware simulado. A garra fisica usa launch/garra_real.launch.py. -->
    <xacro:arg name="hardware_plugin" default="mock_components/GenericSystem"/>
    <xacro:arg name="calibracao_file" default="$(find garra_moveit_config)/config/calibracao_servos.yaml"/>
    <xacro:arg name="porta_serial" default="/dev/ttyUSB0"/>

    <!-- Importa a descrição original do robô -->
    <xacro:include filename="$(find garra_final_description)/urdf/garra_final.urdf" />

    <!-- TCP: ponto medio entre as pontas dos dedos na pose do CAD (dedos fixos, levemente assimetricos),
         a ~138 mm do eixo de J3.
         Fica aqui para sobreviver a uma nova exportacao do CAD. Pai: Base, o corpo da garra apos J3.
         Z aponta na direcao de aproximacao (de J3 para o TCP, perpendicular a J3);
         X fica na direcao de fechamento dos dedos. -->
    <link name="tool0"/>
    <joint name="tool0_fixed" type="fixed">
        <parent link="Base"/>
        <child link="tool0"/>
        <origin xyz="-0.058 -0.1337 -0.0103" rpy="1.6712 0 0"/>
    </joint>

    <!-- J4: servo dos dedos (DS-S006MP, pino 12). Junta provisoria, sem geometria: os dedos da malha
         continuam fixos ate o CAD dos dedos ser finalizado (ai entram as juntas "mimic").
         Valor = angulo do comando do servo (Servo.write), nao o angulo real dos dedos:
         0 = garra aberta (0 graus), 1.484 = fechada no cubo (85 graus; 95 travava as engrenagens), 1.745 = 100 graus. -->
    <link name="dedos_servo"/>
    <joint name="dedos" type="revolute">
        <parent link="Base"/>
        <child link="dedos_servo"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="1.745" effort="0.15" velocity="1.30"/>
    </joint>

    <!-- Estrutura do robo movel (dimensoes.md), so para o MoveIt. Fica aqui, e nao na URDF
         exportada, para sobreviver a uma nova exportacao do CAD.
         Frame "robo_base": centro da base do robo no chao; X frente, Y esquerda, Z cima.
         Todas as geometrias sao caixas simples de colisao. Valores marcados PENDENTE sao
         estimativas conservadoras ate a medicao fisica (ver dimensoes.md, secao 6). -->

    <!-- Base -->
    <xacro:property name="base_x" value="0.55"/>
    <xacro:property name="base_y" value="0.50"/>
    <xacro:property name="base_topo" value="0.100"/>
    <!-- Placa da base: mesma espessura dos andares (1 cm). -->
    <xacro:property name="base_esp" value="0.01"/>

    <!-- Andares (alinhados a borda traseira, X = -base_x/2) -->
    <xacro:property name="esp_andar" value="0.01"/>
    <xacro:property name="a1_x" value="0.39"/>
    <xacro:property name="a1_topo" value="0.270"/>
    <xacro:property name="a2_x" value="0.21"/>
    <xacro:property name="a2_topo" value="0.370"/>

    <!-- Suportes do 1o andar: 0.02 (X) x 0.05 (Y), do topo da base ao fundo do 1o andar -->
    <xacro:property name="s1_x_frente" value="0.050"/>
    <xacro:property name="s1_x_tras" value="-0.205"/>
    <!-- PENDENTE: Y dos suportes do 1o andar. Assumido rente a borda lateral. -->
    <xacro:property name="s1_y" value="0.225"/>

    <!-- Suportes do 2o andar: 0.05 (X) x 0.02 (Y), do topo do 1o andar ao fundo do 2o -->
    <xacro:property name="s2_x_frente" value="-0.090"/>
    <xacro:property name="s2_x_tras" value="-0.250"/>
    <xacro:property name="s2_y" value="0.240"/>

    <!-- Montagem da garra: 0.05 m atras da borda dianteira, no centro, sobre a base.
         A frente da garra e -X do base_link, por isso yaw = pi.
         O fundo da malha do base_link fica 5.4 mm acima da origem; descontado para apoiar
         a garra exatamente no topo da base. -->
    <xacro:property name="garra_x" value="${base_x/2 - 0.050}"/>
    <xacro:property name="garra_z_malha" value="0.0054"/>
    <!-- Plataforma do eixo Y (2026-11-13): eleva a base da garra 68,39 mm acima do topo da base.
         Ainda sem motor: o Y fica fixo no centro. -->
    <xacro:property name="plataforma_z" value="0.06839"/>
    <!-- TEMPORARIO: plataforma como um bloco solido do topo da base ate o pe da garra, um pouco
         maior que o pe dela (malha do base_link: ~0.098 x 0.075 m). Trocar pelas medidas reais. -->
    <xacro:property name="plataforma_lado" value="0.12"/>

    <xacro:macro name="caixa" params="x y z sx sy sz">
        <visual>
            <origin xyz="${x} ${y} ${z}"/>
            <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
            <material name="estrutura_robo"/>
        </visual>
        <collision>
            <origin xyz="${x} ${y} ${z}"/>
            <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
        </collision>
    </xacro:macro>

    <xacro:macro name="andar" params="lx topo">
        <xacro:caixa x="${-base_x/2 + lx/2}" y="0" z="${topo - esp_andar/2}"
                     sx="${lx}" sy="${base_y}" sz="${esp_andar}"/>
    </xacro:macro>

    <xacro:macro name="suporte" params="x y sx sy z0 z1">
        <xacro:caixa x="${x}" y="${y}" z="${(z0 + z1)/2}" sx="${sx}" sy="${sy}" sz="${z1 - z0}"/>
    </xacro:macro>

    <material name="estrutura_robo">
        <color rgba="0.5 0.6 0.7 0.45"/>
    </material>

    <!-- Raiz da arvore: estrutura do robo movel -->
    <link name="robo_base">
        <!-- Chao (Z = 0): 2 x 2 m, so colisao. A garra passa da borda dianteira e alcanca o piso. -->
        <collision>
            <origin xyz="0 0 -0.01"/>
            <geometry><box size="2.0 2.0 0.02"/></geometry>
        </collision>
        <!-- Base -->
        <xacro:caixa x="0" y="0" z="${base_topo - base_esp/2}" sx="${base_x}" sy="${base_y}" sz="${base_esp}"/>
        <!-- PENDENTE: chassi sob a placa da base (rodas, motores). Ate ser medido, fica como volume
             solido do chao ate a placa, para a garra nao planejar por baixo da base. -->
        <xacro:caixa x="0" y="0" z="${(base_topo - base_esp)/2}" sx="${base_x}" sy="${base_y}" sz="${base_topo - base_esp}"/>
        <!-- Plataforma do eixo Y (TEMPORARIO, ver plataforma_lado) -->
        <xacro:caixa x="${garra_x}" y="0" z="${base_topo + plataforma_z/2}"
                     sx="${plataforma_lado}" sy="${plataforma_lado}" sz="${plataforma_z}"/>
        <!-- Andares -->
        <xacro:andar lx="${a1_x}" topo="${a1_topo}"/>
        <xacro:andar lx="${a2_x}" topo="${a2_topo}"/>
        <!-- Suportes do 1o andar -->
        <xacro:suporte x="${s1_x_frente}" y="${ s1_y}" sx="0.02" sy="0.05" z0="${base_topo}" z1="${a1_topo - esp_andar}"/>
        <xacro:suporte x="${s1_x_frente}" y="${-s1_y}" sx="0.02" sy="0.05" z0="${base_topo}" z1="${a1_topo - esp_andar}"/>
        <xacro:suporte x="${s1_x_tras}"   y="${ s1_y}" sx="0.02" sy="0.05" z0="${base_topo}" z1="${a1_topo - esp_andar}"/>
        <xacro:suporte x="${s1_x_tras}"   y="${-s1_y}" sx="0.02" sy="0.05" z0="${base_topo}" z1="${a1_topo - esp_andar}"/>
        <!-- Suportes do 2o andar -->
        <xacro:suporte x="${s2_x_frente}" y="${ s2_y}" sx="0.05" sy="0.02" z0="${a1_topo}" z1="${a2_topo - esp_andar}"/>
        <xacro:suporte x="${s2_x_frente}" y="${-s2_y}" sx="0.05" sy="0.02" z0="${a1_topo}" z1="${a2_topo - esp_andar}"/>
        <xacro:suporte x="${s2_x_tras}"   y="${ s2_y}" sx="0.05" sy="0.02" z0="${a1_topo}" z1="${a2_topo - esp_andar}"/>
        <xacro:suporte x="${s2_x_tras}"   y="${-s2_y}" sx="0.05" sy="0.02" z0="${a1_topo}" z1="${a2_topo - esp_andar}"/>
    </link>

    <joint name="montagem_garra" type="fixed">
        <parent link="robo_base"/>
        <child link="base_link"/>
        <origin xyz="${garra_x} 0 ${base_topo + plataforma_z - garra_z_malha}" rpy="0 0 ${pi}"/>
    </joint>

    <!-- Interface ros2_control (unica definicao do sistema) -->
    <xacro:include filename="$(find garra_moveit_config)/config/garra_final.ros2_control.xacro" />
    <xacro:garra_final_ros2_control
        name="garra_final_system"
        initial_positions_file="$(arg initial_positions_file)"
        hardware_plugin="$(arg hardware_plugin)"
        calibracao_file="$(arg calibracao_file)"
        porta_serial="$(arg porta_serial)"/>

</robot>
